<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />
  <Include href="KnownImageIds.vsct" />

  <Commands package="guidSqlSafetyGuardPackage">
    <Groups>
      <!-- Tools menu -->
      <Group guid="guidSqlSafetyGuardCmdSet" id="ToolsMenuGroup" priority="0x0100">
        <Parent guid="guidSqlSafetyGuardCmdSet" id="SqlSafetyGuardMenu" />
      </Group>
      <!-- SSMS "SQL Editor" toolbar, right after the Execute group (IDG_SQLWB_QUERY_EXEC_TOOLBAR = 0x0300) -->
      <Group guid="guidSqlSafetyGuardCmdSet" id="SqlEditorToolbarGroup" priority="0x0350">
        <Parent guid="guidSsmsQueryEditorGroup" id="IDM_SQLWB_TOOL_QUERY" />
      </Group>
    </Groups>

    <Menus>
      <Menu guid="guidSqlSafetyGuardCmdSet" id="SqlSafetyGuardMenu" priority="0x0100" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
        <Strings><ButtonText>SQL Safety Guard</ButtonText></Strings>
      </Menu>
    </Menus>

    <Buttons>
      <Button guid="guidSqlSafetyGuardCmdSet" id="cmdidAnalyzeQuery" priority="0x0100" type="Button">
        <Parent guid="guidSqlSafetyGuardCmdSet" id="ToolsMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="SQLQueryChecked" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>TextOnly</CommandFlag>
        <Strings>
          <ButtonText>Analyze Query</ButtonText>
          <ToolTipText>Show the safety pane and re-analyze now, without executing (selection, or the whole window)</ToolTipText>
          <CommandName>AnalyzeQuerySafety</CommandName>
          <CanonicalName>.SqlSafetyGuard.AnalyzeQuerySafety</CanonicalName>
          <LocCanonicalName>.SqlSafetyGuard.AnalyzeQuerySafety</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidSqlSafetyGuardCmdSet" id="cmdidExportSettings" priority="0x0110" type="Button">
        <Strings>
          <ButtonText>Export Settings...</ButtonText>
          <ToolTipText>Export your SQL Safety Guard configuration to a JSON file</ToolTipText>
          <CommandName>ExportSafetyGuardSettings</CommandName>
          <CanonicalName>.SqlSafetyGuard.ExportSettings</CanonicalName>
          <LocCanonicalName>.SqlSafetyGuard.ExportSettings</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlSafetyGuardCmdSet" id="cmdidImportSettings" priority="0x0120" type="Button">
        <Strings>
          <ButtonText>Import Settings...</ButtonText>
          <ToolTipText>Validate and preview a SQL Safety Guard settings file before applying it</ToolTipText>
          <CommandName>ImportSafetyGuardSettings</CommandName>
          <CanonicalName>.SqlSafetyGuard.ImportSettings</CanonicalName>
          <LocCanonicalName>.SqlSafetyGuard.ImportSettings</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlSafetyGuardCmdSet" id="cmdidSettings" priority="0x0110" type="Button">
        <Parent guid="guidSqlSafetyGuardCmdSet" id="ToolsMenuGroup" />
        <Strings>
          <ButtonText>Settings...</ButtonText>
          <CommandName>SafetyGuardSettings</CommandName>
          <CanonicalName>.SqlSafetyGuard.Settings</CanonicalName>
          <LocCanonicalName>.SqlSafetyGuard.Settings</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlSafetyGuardCmdSet" id="cmdidToolbarAnalyze" priority="0x0100" type="Button">
        <Parent guid="guidSqlSafetyGuardCmdSet" id="SqlEditorToolbarGroup" />
        <Icon guid="ImageCatalogGuid" id="SQLQueryChecked" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <CommandFlag>TextOnly</CommandFlag>
        <CommandFlag>DynamicAutomationName</CommandFlag>
        <Strings>
          <ButtonText>SQL Safety Guard</ButtonText>
          <ToolTipText>Analyze the selection or whole window without executing (Ctrl+Shift+F5). See the status bar and safety pane for environment and guard details.</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidSqlSafetyGuardCmdSet" id="cmdidEditAllowList" priority="0x0100" type="Button">
        <Strings><ButtonText>Edit safe tables allow-list...</ButtonText></Strings>
      </Button>
      <Button guid="guidSqlSafetyGuardCmdSet" id="cmdidEditTrustedProcedures" priority="0x0100" type="Button">
        <Strings><ButtonText>Edit trusted procedures...</ButtonText></Strings>
      </Button>
      <Button guid="guidSqlSafetyGuardCmdSet" id="cmdidEditEnvironmentRules" priority="0x0100" type="Button">
        <Strings><ButtonText>Edit environment rules...</ButtonText></Strings>
      </Button>
    </Buttons>
  </Commands>



  <KeyBindings>
    <!-- Ctrl+Shift+A is Project.AddNewItem (Global) in SSMS 22, so Ctrl+Shift+F5 is used. Scoped to the SQL Query Editor. -->
    <KeyBinding guid="guidSqlSafetyGuardCmdSet" id="cmdidAnalyzeQuery" editor="guidSsmsSqlEditor" key1="VK_F5" mod1="Control Shift" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidSqlSafetyGuardPackage" value="{71fd7bec-2851-4c61-92a4-4f2435cbd7a1}" />

    <GuidSymbol name="guidSqlSafetyGuardCmdSet" value="{84195f28-a147-4898-bcad-b1ad3c744ae2}">
      <IDSymbol name="ToolsMenuGroup" value="0x1020" />
      <IDSymbol name="SqlSafetyGuardMenu" value="0x1022" />
      <IDSymbol name="SqlEditorToolbarGroup" value="0x1021" />
      <IDSymbol name="cmdidAnalyzeQuery" value="0x0100" />
      <IDSymbol name="cmdidExportSettings" value="0x0101" />
      <IDSymbol name="cmdidImportSettings" value="0x0102" />
      <IDSymbol name="cmdidSettings" value="0x0103" />
      <IDSymbol name="cmdidToolbarAnalyze" value="0x0104" />
      <IDSymbol name="cmdidEditAllowList" value="0x0105" />
      <IDSymbol name="cmdidEditTrustedProcedures" value="0x0106" />
      <IDSymbol name="cmdidEditEnvironmentRules" value="0x0107" />
    </GuidSymbol>

    <!-- SSMS 22 SQLEditors.dll command table (decompiled with vsct.exe): toolbar "SQL Editor" -->
    <GuidSymbol name="guidSsmsQueryEditorGroup" value="{33f13ac3-80bb-4ecb-85bc-225435603a5e}">
      <IDSymbol name="IDM_SQLWB_TOOL_QUERY" value="0x0001" />
    </GuidSymbol>

    <!-- SSMS SQL editor factory: the "SQL Query Editor" key binding scope -->
    <GuidSymbol name="guidSsmsSqlEditor" value="{b5a506eb-11be-4782-9a18-21265c2ca0b4}" />
  </Symbols>
</CommandTable>
