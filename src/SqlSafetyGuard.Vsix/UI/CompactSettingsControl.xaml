<UserControl x:Class="SqlSafetyGuard.UI.CompactSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
    Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}"
    FontSize="12" HorizontalContentAlignment="Stretch">
    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Static vsshell:VsResourceKeys.ThemedDialogButtonStyleKey}}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Padding" Value="0,14" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}" />
        </Style>
        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingHelp" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,20,0" />
        </Style>
    </UserControl.Resources>
    <StackPanel x:Name="SettingsContent" MaxWidth="1000" HorizontalAlignment="Stretch" Margin="0,0,0,8">
        <Border Style="{StaticResource SettingRow}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="F5 warnings" Style="{StaticResource SettingTitle}" />
                    <TextBlock Style="{StaticResource SettingHelp}" Text="Choose when executing SQL requires confirmation. Unknown execution targets always require confirmation." /></StackPanel>
                <ComboBox x:Name="WarningMode" Grid.Column="1" VerticalAlignment="Top" MinHeight="30" Padding="6,4"
                    AutomationProperties.Name="F5 warnings" SelectionChanged="OnModeChanged">
                    <ComboBoxItem Content="Off" /><ComboBoxItem Content="Warn on red only" /><ComboBoxItem Content="Warn on yellow and red" />
                </ComboBox>
            </Grid>
        </Border>
        <Border Style="{StaticResource SettingRow}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Show connection in confirmation" Style="{StaticResource SettingTitle}" />
                    <TextBlock Style="{StaticResource SettingHelp}" Text="Show the server and database in the execution confirmation. Unknown connection details always stay visible." /></StackPanel>
                <CheckBox x:Name="ShowConnection" Grid.Column="1" Content="Enabled" VerticalAlignment="Top" Margin="0,3,0,0"
                    AutomationProperties.Name="Show connection in confirmation" Checked="OnConnectionChanged" Unchecked="OnConnectionChanged" />
            </Grid>
        </Border>
        <Border Style="{StaticResource SettingRow}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Safe tables allow-list" Style="{StaticResource SettingTitle}" />
                    <TextBlock Style="{StaticResource SettingHelp}" Text="Matching data writes become green. This authorizes the target and its side effects; DDL stays red. Use Edit list for one pattern per line; semicolons also work." /></StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Top"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="AllowList" AutomationProperties.Name="Safe tables allow-list" TextChanged="OnAllowListChanged" />
                    <Button Grid.Column="1" Content="Edit list..." Margin="8,0,0,0" Tag="261" Click="OnCommand" AutomationProperties.Name="Edit safe tables allow-list" />
                </Grid>
            </Grid>
        </Border>
        <Border Style="{StaticResource SettingRow}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Trusted procedures" Style="{StaticResource SettingTitle}" />
                    <TextBlock Style="{StaticResource SettingHelp}" Text="Explicitly authorized procedures become green without inspecting their bodies. Use schema-qualified names; wildcards are allowed only in the final part. Use Edit list for one entry per line." /></StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Top"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="TrustedProcedures" AutomationProperties.Name="Trusted procedures" TextChanged="OnTrustedChanged" />
                    <Button Grid.Column="1" Content="Edit list..." Margin="8,0,0,0" Tag="262" Click="OnCommand" AutomationProperties.Name="Edit trusted procedures" />
                </Grid>
            </Grid>
        </Border>
        <Border Style="{StaticResource SettingRow}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Environment rules" Style="{StaticResource SettingTitle}" />
                    <TextBlock Style="{StaticResource SettingHelp}" Text="First matching server/database rule wins. Rule lists ADD to global lists. Unknown connections use global settings. Use Edit rules for a larger editor and the rule format. For examples, see the User guide on the SQL Safety Guard GitHub project page." /></StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Top"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="EnvironmentRules" AutomationProperties.Name="Environment rules" TextChanged="OnRulesChanged" />
                    <Button Grid.Column="1" Content="Edit rules..." Margin="8,0,0,0" Tag="263" Click="OnCommand" AutomationProperties.Name="Edit environment rules" />
                </Grid>
            </Grid>
        </Border>
        <Border Style="{StaticResource SettingRow}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Permanent tempdb objects are temporary" Style="{StaticResource SettingTitle}" />
                    <TextBlock Style="{StaticResource SettingHelp}" Text="Off by default. Turning this on makes writes to permanent shared tempdb objects green. Local and global temporary tables are already treated as temporary." /></StackPanel>
                <CheckBox x:Name="TempdbIsTemp" Grid.Column="1" Content="Enabled" VerticalAlignment="Top" Margin="0,3,0,0"
                    AutomationProperties.Name="Permanent tempdb objects are temporary" Checked="OnTempdbChanged" Unchecked="OnTempdbChanged" />
            </Grid>
        </Border>
        <TextBlock x:Name="SaveError" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Assertive" />
        <WrapPanel Margin="0,16,0,0">
            <Button Content="Import Settings..." Tag="258" Click="OnCommand" Margin="0,0,8,8" />
            <Button Content="Export Settings..." Tag="257" Click="OnCommand" Margin="0,0,8,8" />
            <Button Content="Uninstall SQL Safety Guard..." Tag="264" Click="OnCommand" Margin="0,0,0,8" />
        </WrapPanel>
        <TextBlock Text="Import validates and previews changes before applying them." TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
