<UserControl x:Class="SqlSafetyGuard.UI.SafetyPaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}"
             FontSize="12">
    <UserControl.Resources>
        <Style x:Key="PaneItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent" Padding="8,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformUi:TreeViewColors.SelectedItemInactiveBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformUi:TreeViewColors.SelectedItemInactiveBrushKey}}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemHighlightBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PageButton" TargetType="RadioButton">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ButtonBorder" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource {x:Static platformUi:TreeViewColors.SelectedItemInactiveBrushKey}}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemHighlightBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="GroupTemplate">
            <StackPanel>
                <Grid ToolTip="{Binding Tooltip}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock TextTrimming="CharacterEllipsis" Margin="0,0,12,0" ToolTip="{Binding Key}">
                        <Run Text="{Binding DatabasePrefix, Mode=OneWay}" Foreground="#5c6b7a" /><Run Text="{Binding ObjectName, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding Subtitle}" FontWeight="{Binding ActionWeight}" HorizontalAlignment="Right">
                        <TextBlock.Style><Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsWholeTarget}" Value="True"><Setter Property="Foreground" Value="{Binding ActionBrush}" /></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock Text="{Binding Reason}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}" Opacity="0.75" FontSize="11" Margin="0,3,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="ObjectList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PaneItem}" />
            <Setter Property="ItemTemplate" Value="{StaticResource GroupTemplate}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <DataTemplate x:Key="PatternTemplate">
            <DockPanel Margin="0,3">
                <Border DockPanel.Dock="Right" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="8,0,0,0" BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}">
                    <TextBlock Text="{Binding Source}" FontSize="10" />
                </Border>
                <TextBlock Text="{Binding Pattern}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" ToolTip="{Binding Pattern}" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <Thumb x:Name="Grip" DockPanel.Dock="Left" Width="4" Cursor="SizeWE" DragDelta="OnGripDragDelta">
            <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}" /></ControlTemplate></Thumb.Template>
        </Thumb>
        <Border x:Name="CollapsedStrip" Visibility="Collapsed" Cursor="Hand" Background="Transparent"
                MouseLeftButtonUp="OnToggleClicked">
            <StackPanel Margin="2,10,2,0">
                <Grid x:Name="CollapsedStatus" Width="20" Height="20">
                    <Ellipse x:Name="CollapsedDot" Fill="Gray" />
                    <TextBlock x:Name="CollapsedGlyph" Foreground="White" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <Grid x:Name="CollapsedRed" Width="20" Height="20" Visibility="Collapsed" Margin="0,0,0,6">
                    <Ellipse x:Name="CollapsedRedDot" />
                    <Viewbox Margin="2" StretchDirection="DownOnly">
                        <TextBlock x:Name="CollapsedRedCount" FontWeight="Bold" />
                    </Viewbox>
                </Grid>
                <Grid x:Name="CollapsedYellow" Width="20" Height="20" Visibility="Collapsed">
                    <Ellipse x:Name="CollapsedYellowDot" />
                    <Viewbox Margin="2" StretchDirection="DownOnly">
                        <TextBlock x:Name="CollapsedYellowCount" FontWeight="Bold" />
                    </Viewbox>
                </Grid>
            </StackPanel>
        </Border>

        <DockPanel x:Name="Expanded">
            <Border x:Name="EnvironmentLine" DockPanel.Dock="Top" Height="3" Visibility="Collapsed" />
            <Border DockPanel.Dock="Top" Height="34" Padding="8,0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}">
                <DockPanel>
                    <Button x:Name="CollapseButton" DockPanel.Dock="Right" Content="»" FontSize="15" Padding="4,0" Margin="5,0,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}" ToolTip="Collapse the pane" Click="OnCollapseClicked" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <RadioButton x:Name="AnalysisButton" Content="☰ Analysis" GroupName="Page" Style="{StaticResource PageButton}" IsChecked="True" Checked="OnAnalysisPage" />
                        <RadioButton x:Name="SettingsButton" Content="⚙ Settings" GroupName="Page" Style="{StaticResource PageButton}" Checked="OnSettingsPage" />
                    </StackPanel>
                    <StackPanel x:Name="HeaderCounts" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0">
                        <Grid x:Name="HeaderStatus" Width="20" Height="20"><Ellipse x:Name="HeaderDot" Fill="Gray" /><TextBlock x:Name="HeaderGlyph" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
                        <Grid x:Name="HeaderRed" Width="20" Height="20" Visibility="Collapsed" Margin="0,0,4,0"><Ellipse x:Name="HeaderRedDot" /><Viewbox Margin="2" StretchDirection="DownOnly"><TextBlock x:Name="HeaderRedCount" Foreground="White" FontWeight="Bold" /></Viewbox></Grid>
                        <Grid x:Name="HeaderYellow" Width="20" Height="20" Visibility="Collapsed"><Ellipse x:Name="HeaderYellowDot" /><Viewbox Margin="2" StretchDirection="DownOnly"><TextBlock x:Name="HeaderYellowCount" Foreground="Black" FontWeight="Bold" /></Viewbox></Grid>
                    </StackPanel>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ScopeText" Text="Whole window" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Border x:Name="EnvironmentTag" Grid.Column="1" Padding="4,1" CornerRadius="2" Margin="6,0,5,0" MaxWidth="90" Visibility="Collapsed"><TextBlock x:Name="EnvironmentText" Foreground="White" FontSize="10" TextTrimming="CharacterEllipsis" /></Border>
                    </Grid>
                </DockPanel>
            </Border>
            <Grid>
                <DockPanel x:Name="AnalysisPage">
                    <Expander x:Name="SafeSection" DockPanel.Dock="Bottom" Visibility="Collapsed" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}" Padding="4,6" MaxHeight="200">
                        <Expander.Header><TextBlock x:Name="SafeHeader" FontSize="11" /></Expander.Header>
                        <ListBox x:Name="SafeList" Style="{StaticResource ObjectList}" SelectionChanged="OnGroupSelectionChanged" MouseDoubleClick="OnGroupDoubleClick" KeyDown="OnGroupKeyDown" />
                    </Expander>
                    <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Margin="10" Opacity="0.7" TextWrapping="Wrap" Visibility="Collapsed" />
                    <ListBox x:Name="GroupList" Style="{StaticResource ObjectList}" SelectionChanged="OnGroupSelectionChanged" MouseDoubleClick="OnGroupDoubleClick" KeyDown="OnGroupKeyDown">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate><DataTemplate>
                                    <DockPanel Margin="10,12,10,4">
                                        <TextBlock DockPanel.Dock="Left" FontSize="10" FontWeight="SemiBold" Margin="0,0,8,0"><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding ItemCount, Mode=OneWay}" /></TextBlock>
                                        <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}" />
                                    </DockPanel>
                                </DataTemplate></GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                </DockPanel>
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,10">
                        <TextBlock Text="Connection" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap"><Run Text="Server: " /><Run Text="{Binding Server, Mode=OneWay}" /></TextBlock>
                        <TextBlock TextWrapping="Wrap"><Run Text="Database: " /><Run Text="{Binding Database, Mode=OneWay}" /></TextBlock>
                        <TextBlock TextWrapping="Wrap"><Run Text="Environment: " /><Run Text="{Binding EnvironmentDescription, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="F5 guard" FontWeight="SemiBold" Margin="0,16,0,6" />
                        <TextBlock TextWrapping="Wrap"><Run Text="When it asks: " /><Run Text="{Binding WhenToAsk, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{Binding TypedConfirmation}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding SafeTablesHeading}" FontWeight="SemiBold" Margin="0,16,0,6" />
                        <ItemsControl ItemsSource="{Binding SafeTables}" ItemTemplate="{StaticResource PatternTemplate}" />
                        <TextBlock Text="{Binding TrustedProceduresHeading}" FontWeight="SemiBold" Margin="0,16,0,6" />
                        <ItemsControl ItemsSource="{Binding TrustedProcedures}" ItemTemplate="{StaticResource PatternTemplate}" />
                        <TextBlock Text="tempdb tables" FontWeight="SemiBold" Margin="0,16,0,6" />
                        <TextBlock Text="{Binding Tempdb}" />
                        <Button Content="Edit in Tools › Options…" HorizontalAlignment="Left" Margin="0,18,0,0" Padding="8,4" Click="OnEditOptions" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </DockPanel>
</UserControl>
