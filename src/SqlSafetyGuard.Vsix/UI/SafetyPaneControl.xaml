<UserControl x:Class="SqlSafetyGuard.UI.SafetyPaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}"
             FontSize="12">
    <UserControl.Resources>
        <Style x:Key="LineNumber" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemGrayTextBrushKey}}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <!-- Keep verdict shapes visible when their semantic fill is close to the theme background. -->
        <Style TargetType="Ellipse">
            <Setter Property="Stroke" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>
        <Style x:Key="PaneItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent" Padding="8,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformUi:TreeViewColors.SelectedItemInactiveBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformUi:TreeViewColors.SelectedItemInactiveBrushKey}}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemHighlightBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PageButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ButtonBorder" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource {x:Static platformUi:TreeViewColors.SelectedItemInactiveBrushKey}}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemHighlightBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterButton" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="FontSize" Value="11" /><Setter Property="Padding" Value="5,3" /><Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformUi:TreeViewColors.SelectedItemInactiveBrushKey}}" /><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemHighlightBrushKey}}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="RowExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button x:Name="RowHeader" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          Grid.Column="1"
                                          HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                          Foreground="{TemplateBinding Foreground}"
                                          AutomationProperties.Name="{Binding Tooltip}"
                                          Click="OnRowClick" MouseDoubleClick="OnRowDoubleClick" KeyDown="OnRowKeyDown">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="FocusBorder" BorderThickness="1" BorderBrush="Transparent" Padding="0,2">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemHighlightBrushKey}}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="RowArrow" Grid.Column="0" Content="{Binding Chevron}" Click="OnRowArrowClick"
                                    Foreground="{TemplateBinding Foreground}" Background="Transparent" BorderThickness="0" Padding="0"
                                    ToolTip="Expand or collapse details" AutomationProperties.Name="Expand or collapse details"
                                    AutomationProperties.HelpText="{Binding Tooltip}" />
                          </Grid>
                            <ContentPresenter x:Name="RowDetails" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="RowDetails" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="BodyBadgeTemplate">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding Tooltip}" VerticalAlignment="Center" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal" Visibility="{Binding InsideVisibility}" Margin="0,0,5,0"><Ellipse Width="7" Height="7" Fill="{Binding InsideMarker}" Margin="0,0,3,0" /><TextBlock Text="{Binding InsideTotal}" FontSize="11" /></StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding RemoteVisibility}" Margin="0,0,5,0"><Ellipse Width="7" Height="7" Fill="{Binding RemoteMarker}" Margin="0,0,3,0" /><TextBlock Text="{Binding RemoteTotal}" FontSize="11" /></StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PreviewHeaderTemplate">
            <Grid ToolTip="{Binding Tooltip}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="13" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="{Binding LineGutterWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" /></Grid.ColumnDefinitions>
                <Ellipse Width="7" Height="7" Fill="{Binding Marker}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding PreviewLabel}" TextTrimming="CharacterEllipsis" Margin="0,0,5,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding RedVisibility}" Margin="0,0,5,0"><Ellipse Width="6" Height="6" Fill="{Binding RedMarker}" Margin="0,0,3,0" /><TextBlock Text="{Binding DisplayCounts.Writes}" FontSize="11" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding YellowVisibility}" Margin="0,0,5,0"><Ellipse Width="6" Height="6" Fill="{Binding YellowMarker}" Margin="0,0,3,0" /><TextBlock Text="{Binding DisplayCounts.Unknown}" FontSize="11" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding GreenVisibility}" Margin="0,0,5,0"><Ellipse Width="6" Height="6" Fill="{Binding GreenMarker}" Margin="0,0,3,0" /><TextBlock Text="{Binding DisplayCounts.Safe}" FontSize="11" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ContextVisibility}" Margin="0,0,5,0"><Ellipse Width="6" Height="6" Fill="{Binding ContextMarker}" Margin="0,0,3,0" /><TextBlock Text="{Binding DisplayCounts.Context}" FontSize="11" /></StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="GroupRowHeaderTemplate">
            <Grid ToolTip="{Binding Tooltip}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="{Binding LineGutterWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" /></Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" Fill="{Binding Marker}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ObjectName}" Margin="0,0,8,0" ToolTip="{Binding DisplayName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" ToolTip="{Binding CountTooltip}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding RedVisibility}" Margin="0,0,5,0"><Ellipse Width="6" Height="6" Fill="{Binding RedMarker}" Margin="0,0,3,0" /><TextBlock Text="{Binding DisplayCounts.Writes}" FontSize="11" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding YellowVisibility}" Margin="0,0,5,0"><Ellipse Width="6" Height="6" Fill="{Binding YellowMarker}" Margin="0,0,3,0" /><TextBlock Text="{Binding DisplayCounts.Unknown}" FontSize="11" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding GreenVisibility}" Margin="0,0,5,0"><Ellipse Width="6" Height="6" Fill="{Binding GreenMarker}" Margin="0,0,3,0" /><TextBlock Text="{Binding DisplayCounts.Safe}" FontSize="11" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ContextVisibility}" Margin="0,0,5,0" ToolTip="{Binding ContextTooltip}"><Ellipse Width="6" Height="6" Fill="{Binding ContextMarker}" Margin="0,0,3,0" /><TextBlock Text="{Binding DisplayCounts.Context}" FontSize="11" /></StackPanel>
                    <ContentControl Content="{Binding BodyBadge}" Visibility="{Binding BodyBadgeVisibility}" ContentTemplate="{StaticResource BodyBadgeTemplate}" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding VisibleLine}" Style="{StaticResource LineNumber}" ToolTip="First visible operation's source line" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="GroupReasonTemplate">
            <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" FontSize="11">
                <TextBlock.Style><Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemGrayTextBrushKey}}" />
                    <Style.Triggers><DataTrigger Binding="{Binding IsWholeTarget}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowValidationErrorTextBrushKey}}" /><Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="SectionHeaderTemplate">
            <DockPanel Margin="10,12,10,4">
                <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding Items[0].Marker}" />
                <TextBlock DockPanel.Dock="Left" FontSize="10" FontWeight="Bold" Margin="0,0,8,0"><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding ItemCount, Mode=OneWay}" /></TextBlock>
                <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="FindingHeaderTemplate">
            <Grid ToolTip="{Binding Tooltip}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="13" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="{Binding LineGutterWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" /></Grid.ColumnDefinitions>
                <Ellipse Width="7" Height="7" Fill="{Binding Marker}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding InlineLabel}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,5,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Content="{Binding Body.Badge}" Visibility="{Binding BodyVisibility}" ContentTemplate="{StaticResource BodyBadgeTemplate}" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding EditorLine}" Style="{StaticResource LineNumber}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="BodyFindingTemplate">
            <Expander Style="{StaticResource RowExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Header="{Binding}" HeaderTemplate="{StaticResource FindingHeaderTemplate}" Margin="0,1">
                <StackPanel>
                    <TextBlock Text="{Binding Reason}" Visibility="{Binding ReasonVisibility}" FontSize="11" TextWrapping="Wrap" Margin="18,2,0,5">
                        <TextBlock.Style><Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemGrayTextBrushKey}}" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsPermanentWholeTarget}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowValidationErrorTextBrushKey}}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <WrapPanel Visibility="{Binding SourceLocationVisibility}" Margin="18,0,0,5">
                        <Button Content="{Binding SourceLocation}" IsEnabled="{Binding HasSource}" Click="OnSqlSourceClicked" ToolTip="Go to the contributing SQL string" FontSize="11" Padding="0" Margin="0,0,8,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemGrayTextBrushKey}}" />
                        <Button Content="{Binding ExecutionLocation}" Click="OnSqlExecutionClicked" ToolTip="Go to the containing operation" FontSize="11" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemGrayTextBrushKey}}" />
                    </WrapPanel>
                    <ContentControl Content="{Binding Body}" Visibility="{Binding BodyVisibility}" ContentTemplate="{DynamicResource ProcedureBodyTemplate}" />
                </StackPanel>
            </Expander>
        </DataTemplate>
        <DataTemplate x:Key="ProcedureBodyTemplate">
            <Expander Style="{StaticResource RowExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Header="{Binding}" HeaderTemplate="{StaticResource PreviewHeaderTemplate}" Margin="18,4,0,4">
                <Border Margin="18,3,0,0" Padding="4,0,0,0" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}">
                    <StackPanel>
                        <TextBlock Text="Body analysis incomplete." Visibility="{Binding IncompleteVisibility}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding VisibleFindings}" ItemTemplate="{StaticResource BodyFindingTemplate}" />
                    </StackPanel>
                </Border>
            </Expander>
        </DataTemplate>
        <DataTemplate x:Key="GroupTemplate">
            <Expander Style="{StaticResource RowExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                      Header="{Binding}" HeaderTemplate="{StaticResource GroupRowHeaderTemplate}">
                <StackPanel Margin="0,5,0,3">
                    <TextBlock Text="Decoded SQL" Visibility="{Binding DynamicScopeVisibility}" Margin="18,0,0,3" FontSize="11" Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemGrayTextBrushKey}}" />
                    <ItemsControl ItemsSource="{Binding VisibleFindings}" ItemTemplate="{StaticResource BodyFindingTemplate}" Margin="18,3,0,0" />
                </StackPanel>
            </Expander>
        </DataTemplate>
        <Style x:Key="ObjectList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PaneItem}" />
            <Setter Property="ItemTemplate" Value="{StaticResource GroupTemplate}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <!-- Expanded objects may exceed the viewport; scroll within them while retaining virtualization. -->
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        </Style>
        <!-- Explicit state arrows: collapsed points down, expanded points up. -->
        <Style x:Key="SafeSectionExpander" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <ToggleButton x:Name="SafeSectionToggle" DockPanel.Dock="Top"
                                              Content="{TemplateBinding Header}"
                                              Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Stretch"
                                              AutomationProperties.Name="{Binding Header.Text, RelativeSource={RelativeSource TemplatedParent}}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="FocusBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="2">
                                                <DockPanel>
                                                    <Path x:Name="SafeSectionChevron" DockPanel.Dock="Left" Width="8" Height="4" Margin="2,0,8,0"
                                                          VerticalAlignment="Center" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                                                          Data="M 0,0 L 4,4 L 8,0" />
                                                    <ContentPresenter />
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="SafeSectionChevron" Property="Data" Value="M 0,4 L 4,0 L 8,4" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemHighlightBrushKey}}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="SafeSectionDetails" Visibility="Collapsed" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="SafeSectionDetails" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="PatternTemplate">
            <DockPanel Margin="0,3">
                <Border DockPanel.Dock="Right" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="8,0,0,0" BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}">
                    <TextBlock Text="{Binding Source}" FontSize="10" />
                </Border>
                <TextBlock Text="{Binding Pattern}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" ToolTip="{Binding Pattern}" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <Thumb x:Name="Grip" DockPanel.Dock="Left" Width="4" Cursor="SizeWE" DragDelta="OnGripDragDelta">
            <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}" /></ControlTemplate></Thumb.Template>
        </Thumb>
        <Border x:Name="CollapsedStrip" Visibility="Collapsed" Cursor="Hand" Background="Transparent"
                MouseLeftButtonUp="OnToggleClicked">
            <StackPanel Margin="2,10,2,0">
                <Grid x:Name="CollapsedStatus" Width="20" Height="20">
                    <Ellipse Fill="Gray" />
                </Grid>
                <StackPanel x:Name="CollapsedCounts" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <DockPanel x:Name="Expanded">
            <Border x:Name="EnvironmentLine" DockPanel.Dock="Top" Height="3" Visibility="Collapsed" />
            <Border DockPanel.Dock="Top" Height="34" Padding="8,0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}">
                <DockPanel>
                    <Button x:Name="CollapseButton" DockPanel.Dock="Right" Content="»" FontSize="15" Padding="4,0" Margin="5,0,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}" ToolTip="Collapse the pane" Click="OnCollapseClicked" />
                    <Border DockPanel.Dock="Right" VerticalAlignment="Center" BorderThickness="1" CornerRadius="2"
                            BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="AnalysisButton" Content="☰" ToolTip="Analysis" AutomationProperties.Name="Analysis" GroupName="Page" Style="{StaticResource PageButton}" IsChecked="True" Checked="OnAnalysisPage" />
                            <RadioButton x:Name="SettingsButton" Content="⚙" ToolTip="Settings" AutomationProperties.Name="Settings" GroupName="Page" Style="{StaticResource PageButton}" Checked="OnSettingsPage" />
                        </StackPanel>
                    </Border>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ScopeText" Text="Whole window" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Border x:Name="EnvironmentTag" Grid.Column="1" Padding="4,1" CornerRadius="2" Margin="6,0,5,0" MaxWidth="90" Visibility="Collapsed"><TextBlock x:Name="EnvironmentText" Foreground="White" FontSize="10" TextTrimming="CharacterEllipsis" /></Border>
                    </Grid>
                </DockPanel>
            </Border>
            <Grid>
                <DockPanel x:Name="AnalysisPage" Background="Transparent" PreviewMouseLeftButtonDown="OnAnalysisBackgroundMouseDown">
                    <StackPanel x:Name="FilterBar" Orientation="Horizontal" DockPanel.Dock="Top" Margin="8,6,5,6" ToolTip="Filter displayed operations only. Overall warnings and counts remain unchanged.">
                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Filter labels">
                                    <MenuItem x:Name="LabelsAutomatic" Header="Automatic" Tag="Automatic" IsCheckable="True" IsChecked="True" Click="OnFilterLabelsClick" />
                                    <MenuItem x:Name="LabelsText" Header="Text" Tag="Text" IsCheckable="True" Click="OnFilterLabelsClick" />
                                    <MenuItem x:Name="LabelsCircles" Header="Circles" Tag="Circles" IsCheckable="True" Click="OnFilterLabelsClick" />
                                </MenuItem>
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <ToggleButton x:Name="FilterWrites" Tag="Writes" Style="{StaticResource FilterButton}" Click="OnFilterClick" />
                        <ToggleButton x:Name="FilterUnknown" Tag="Unknown" Style="{StaticResource FilterButton}" Click="OnFilterClick" />
                        <ToggleButton x:Name="FilterSafe" Tag="Safe" Style="{StaticResource FilterButton}" Click="OnFilterClick" />
                        <Separator Width="1" Margin="2,3,5,3" />
                        <ToggleButton x:Name="FilterInside" Tag="Inside" Style="{StaticResource FilterButton}" Click="OnFilterClick" />
                        <ToggleButton x:Name="FilterContext" Tag="Context" Style="{StaticResource FilterButton}" Click="OnFilterClick" />
                        <ToggleButton x:Name="FilterRemote" Tag="Remote" Style="{StaticResource FilterButton}" Click="OnFilterClick" />
                    </StackPanel>
                    <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Margin="10" Opacity="0.7" TextWrapping="Wrap" Visibility="Collapsed" />
                    <ListBox x:Name="GroupList" Style="{StaticResource ObjectList}" SelectionChanged="OnGroupSelectionChanged" KeyDown="OnGroupKeyDown" />
                </DockPanel>
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,10">
                        <TextBlock Text="Connection" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap"><Run Text="Server: " /><Run Text="{Binding Server, Mode=OneWay}" /></TextBlock>
                        <TextBlock TextWrapping="Wrap"><Run Text="Database: " /><Run Text="{Binding Database, Mode=OneWay}" /></TextBlock>
                        <TextBlock TextWrapping="Wrap"><Run Text="Environment: " /><Run Text="{Binding EnvironmentDescription, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="F5 guard" FontWeight="SemiBold" Margin="0,16,0,6" />
                        <TextBlock TextWrapping="Wrap"><Run Text="When it asks: " /><Run Text="{Binding WhenToAsk, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{Binding TypedConfirmation}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding SafeTablesHeading}" FontWeight="SemiBold" Margin="0,16,0,6" />
                        <ItemsControl ItemsSource="{Binding SafeTables}" ItemTemplate="{StaticResource PatternTemplate}" />
                        <TextBlock Text="{Binding TrustedProceduresHeading}" FontWeight="SemiBold" Margin="0,16,0,6" />
                        <ItemsControl ItemsSource="{Binding TrustedProcedures}" ItemTemplate="{StaticResource PatternTemplate}" />
                        <TextBlock Text="tempdb tables" FontWeight="SemiBold" Margin="0,16,0,6" />
                        <TextBlock Text="{Binding Tempdb}" />
                        <Button Content="Settings..." Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ThemedDialogButtonStyleKey}}" HorizontalAlignment="Left" Margin="0,18,0,0" Padding="8,4" Click="OnEditOptions" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </DockPanel>
</UserControl>
