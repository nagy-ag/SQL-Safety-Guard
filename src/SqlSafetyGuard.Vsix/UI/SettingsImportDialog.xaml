<platformUi:DialogWindow x:Class="SqlSafetyGuard.UI.SettingsImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
    Title="Import SQL Safety Guard Settings" Width="800" Height="640" MinWidth="640" MinHeight="360"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{DynamicResource {x:Static platformUi:ThemedDialogColors.WindowPanelBrushKey}}"
    Foreground="{DynamicResource {x:Static platformUi:ThemedDialogColors.WindowPanelTextBrushKey}}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Review settings before importing" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Source}" TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.75" />
            <TextBlock Text="Nothing changes until you choose Import settings. These settings replace your configuration." TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border x:Name="WarningSection" BorderThickness="2" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="&#x26A0; MORE QUERIES WILL RUN WITHOUT A PROMPT" FontWeight="Bold" TextWrapping="Wrap" />
                        <ItemsControl x:Name="Warnings" ItemsSource="{Binding Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,10,0,0" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="IgnoredKeys" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock x:Name="ChangesHeading" Text="CHANGES (OLD → NEW)" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Changes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="OLD" FontWeight="SemiBold" Opacity="0.7" />
                                        <TextBlock Text="{Binding Before}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="NEW" FontWeight="SemiBold" Opacity="0.7" />
                                        <TextBlock Text="{Binding After}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="ImportButton" Content="Import settings" MinWidth="120" Margin="0,0,8,0" Click="OnImport"
                Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ThemedDialogButtonStyleKey}}" />
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="110" IsDefault="True" IsCancel="True"
                BorderThickness="2" BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemHighlightBrushKey}}"
                Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ThemedDialogButtonStyleKey}}" />
        </StackPanel>
    </Grid>
</platformUi:DialogWindow>
