<platformUi:DialogWindow x:Class="SqlSafetyGuard.UI.PatternListDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
    Width="900" Height="580" MinWidth="700" MinHeight="440"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{DynamicResource {x:Static platformUi:ThemedDialogColors.WindowPanelBrushKey}}"
    Foreground="{DynamicResource {x:Static platformUi:ThemedDialogColors.WindowPanelTextBrushKey}}">
    <platformUi:DialogWindow.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <SolidColorBrush x:Key="ProblemBrush" Color="#C62828" />
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Static vsshell:VsResourceKeys.ThemedDialogButtonStyleKey}}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </platformUi:DialogWindow.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Description" TextWrapping="Wrap" Margin="0,0,0,12" />
        <Border x:Name="TrustWarning" Grid.Row="1" BorderBrush="{StaticResource ProblemBrush}" BorderThickness="3,0,0,0"
            Padding="9,5" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" Text="Only add procedures you know are safe. SQL Safety Guard trusts your word and does not look inside them." />
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="AddButton" Content="+ Add" Click="OnAdd" Margin="0,0,6,0" AutomationProperties.Name="Add entry" />
                    <Button x:Name="UpButton" Content="↑" Click="OnUp" Margin="0,0,6,0" MinWidth="32" AutomationProperties.Name="Move up" />
                    <Button x:Name="DownButton" Content="↓" Click="OnDown" Margin="0,0,6,0" MinWidth="32" AutomationProperties.Name="Move down" />
                    <Button x:Name="RemoveButton" Content="Remove" Click="OnRemove" />
                </StackPanel>
                <ListBox x:Name="EntryList" SelectionChanged="OnSelectionChanged" HorizontalContentAlignment="Stretch"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Entries"
                    Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
                    Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                    BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding Display}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Note}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis"
                                    Visibility="{Binding HasNote, Converter={StaticResource Visible}}" />
                                <TextBlock Text="{Binding Problem, StringFormat=⚠ {0}}" FontSize="11" TextWrapping="Wrap"
                                    Foreground="{StaticResource ProblemBrush}" Visibility="{Binding HasProblem, Converter={StaticResource Visible}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <TextBlock x:Name="EmptyText" Grid.Column="2" TextWrapping="Wrap" Opacity="0.8" Visibility="Collapsed"
                Text="No entries. Choose + Add to create one." />
            <ScrollViewer x:Name="FormScroller" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Form" Margin="0,0,4,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="1.5*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Server" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="Database" Grid.Column="2" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="Schema" Grid.Column="4" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="NameLabel" Text="Table" Grid.Column="6" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ServerBox" Grid.Row="1" FontFamily="Consolas" TextChanged="OnPartChanged" AutomationProperties.Name="Server" />
                        <TextBox x:Name="DatabaseBox" Grid.Row="1" Grid.Column="2" FontFamily="Consolas" TextChanged="OnPartChanged" AutomationProperties.Name="Database" />
                        <TextBox x:Name="SchemaBox" Grid.Row="1" Grid.Column="4" FontFamily="Consolas" TextChanged="OnPartChanged" AutomationProperties.Name="Schema" />
                        <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="6" FontFamily="Consolas" TextChanged="OnPartChanged" AutomationProperties.Name="Name" />
                    </Grid>
                    <TextBlock x:Name="PartsHint" Style="{StaticResource Hint}" />
                    <TextBlock Text="Note" Style="{StaticResource FieldLabel}" Margin="0,14,0,3" />
                    <TextBox x:Name="NoteBox" TextChanged="OnNoteChanged" AutomationProperties.Name="Note" />
                    <TextBlock x:Name="FormProblem" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{StaticResource ProblemBrush}" Visibility="Collapsed" />
                    <Border x:Name="ExplainBox" Margin="0,14,0,0" Padding="10,8" BorderThickness="1"
                        BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}">
                        <StackPanel>
                            <TextBlock Text="What this matches" FontWeight="SemiBold" />
                            <TextBlock x:Name="ExplainText" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Try a name" Style="{StaticResource FieldLabel}" Margin="0,14,0,3" />
                    <TextBox x:Name="TryBox" FontFamily="Consolas" TextChanged="OnTryChanged" AutomationProperties.Name="Try a name" />
                    <TextBlock x:Name="TryResult" Style="{StaticResource Hint}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <TextBlock x:Name="Error" Grid.Row="3" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource ProblemBrush}" Visibility="Collapsed" />
        <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="EditAsTextButton" Content="Edit as text..." Click="OnEditAsText" DockPanel.Dock="Left" />
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" IsCancel="True" DockPanel.Dock="Right" />
            <Button x:Name="SaveButton" Content="Save" MinWidth="90" Click="OnSave" Margin="0,0,8,0" DockPanel.Dock="Right" />
        </DockPanel>
    </Grid>
</platformUi:DialogWindow>
