<UserControl x:Class="SqlSafetyGuard.UI.ResultsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}">
    <DockPanel>
        <Border x:Name="Banner" DockPanel.Dock="Top" Padding="10,6" Background="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBackgroundBrushKey}}">
            <DockPanel>
                <CheckBox x:Name="WarningsOnly" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                          Content="Only yellow/red" Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
                <StackPanel>
                    <TextBlock x:Name="BannerText" FontSize="14" FontWeight="SemiBold" Text="No analysis yet" />
                    <TextBlock x:Name="BannerDetail" TextWrapping="Wrap" Opacity="0.9" />
                </StackPanel>
            </DockPanel>
        </Border>
        <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Margin="10" TextWrapping="Wrap"
                   Text="Use Tools &gt; Analyze Query Safety (Ctrl+Shift+F5) or the SQL Editor toolbar button to check the current query without running it. Double-click a row to jump to it." />
        <DataGrid x:Name="Grid"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                  EnableRowVirtualization="True"
                  Background="Transparent" RowBackground="Transparent"
                  Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}"
                  HorizontalGridLinesBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}"
                  MouseDoubleClick="OnGridDoubleClick" PreviewKeyDown="OnGridKeyDown">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource {x:Static platformUi:HeaderColors.DefaultBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:HeaderColors.DefaultTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                    <Setter Property="Padding" Value="6,3" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <!-- Statements in a batch with a syntax error: they won't run now. -->
                        <DataTrigger Binding="{Binding WillRun}" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                            <Setter Property="FontStyle" Value="Italic" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="4,2" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemHighlightBrushKey}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemHighlightTextBrushKey}}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="24" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="10" Height="10" Fill="{Binding Marker}" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="Auto" MinWidth="55" />
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="Auto" MinWidth="80" />
                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="*" MinWidth="120" />
                <DataGridTextColumn Header="Verdict" Binding="{Binding VerdictText}" Width="Auto" MinWidth="80" />
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="2*" MinWidth="120" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
