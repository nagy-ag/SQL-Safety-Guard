<platformUi:DialogWindow x:Class="SqlSafetyGuard.UI.ConfirmExecutionDialog"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                         xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
                         Title="SQL Safety Guard" Width="660" SizeToContent="Height" MaxHeight="720"
                         ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                         Background="{DynamicResource {x:Static platformUi:ThemedDialogColors.WindowPanelBrushKey}}"
                         Foreground="{DynamicResource {x:Static platformUi:ThemedDialogColors.WindowPanelTextBrushKey}}">
    <platformUi:DialogWindow.Resources>
        <DataTemplate x:Key="LedgerRowTemplate">
            <Grid Margin="10,7" Opacity="{Binding Opacity}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ObjectName}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip="{Binding ObjectName}" />
                <TextBlock Grid.Column="1" Text="{Binding Statements}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip="{Binding Statements}" />
                <TextBlock Grid.Column="2" Text="{Binding Lines}" TextTrimming="CharacterEllipsis" TextAlignment="Right" ToolTip="{Binding Lines}" Opacity="0.75" />
            </Grid>
        </DataTemplate>
        <Style x:Key="LedgerSection" TargetType="Expander">
            <Setter Property="IsExpanded" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:ThemedDialogColors.WindowPanelTextBrushKey}}" />
        </Style>
    </platformUi:DialogWindow.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="ConnectionText" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="EnvironmentText" Margin="0,4,0,0" Opacity="0.75" TextWrapping="Wrap" />
            <TextBlock Text="Run this query anyway?" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,4" />
            <TextBlock Text="Execution is paused. Nothing has run yet." TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" MaxHeight="500" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Expander x:Name="RedSection" Style="{StaticResource LedgerSection}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Ellipse x:Name="RedMarker" Width="8" Height="8" Margin="0,0,8,0" />
                            <TextBlock Text="CHANGES TO PERMANENT OBJECTS" FontWeight="SemiBold" />
                            <TextBlock x:Name="RedCount" Margin="12,0,0,0" FontWeight="SemiBold" />
                        </StackPanel>
                    </Expander.Header>
                    <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RedList" ItemTemplate="{StaticResource LedgerRowTemplate}" Focusable="False" />
                    </ScrollViewer>
                </Expander>
                <Expander x:Name="YellowSection" Style="{StaticResource LedgerSection}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Ellipse x:Name="YellowMarker" Width="8" Height="8" Margin="0,0,8,0" />
                            <TextBlock Text="CAN'T SEE INSIDE" FontWeight="SemiBold" />
                            <TextBlock x:Name="YellowCount" Margin="12,0,0,0" FontWeight="SemiBold" />
                        </StackPanel>
                    </Expander.Header>
                    <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="YellowList" ItemTemplate="{StaticResource LedgerRowTemplate}" Focusable="False" />
                    </ScrollViewer>
                </Expander>
                <TextBlock x:Name="BlockedText" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" Opacity="0.75" />
                <TextBlock x:Name="SettingsText" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                <TextBlock x:Name="TargetSwitchText" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                           Text="USE / :connect switches destinations inside this script. Check every destination; the displayed connection is the initial one." />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="RunButton" Content="Run anyway" MinWidth="110" Margin="0,0,8,0" Click="OnRunAnyway"
                    Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ThemedDialogButtonStyleKey}}" />
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="110" IsDefault="True" IsCancel="True"
                    BorderThickness="2" BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemHighlightBrushKey}}"
                    Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ThemedDialogButtonStyleKey}}" />
        </StackPanel>
    </Grid>
</platformUi:DialogWindow>
